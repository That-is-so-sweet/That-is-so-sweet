# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional. Enables real delivery of the host's "cancel event"
# notification email via Resend's HTTP API (https://resend.com).
# Without it, cancellation still works — the email is just logged to the
# server console instead of actually sent.
RESEND_API_KEY=""

# MAIL_FROM: Optional. Sender shown on cancellation emails. Defaults to a
# Resend sandbox address if not set.
MAIL_FROM="揪團通知 <onboarding@resend.dev>"
